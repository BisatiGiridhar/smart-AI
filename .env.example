# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_TTL_MINUTES=480

# Optional: create the first admin automatically (otherwise use the setup screen)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Dataset
HF_DATASET_REPO=michaelozon/candidate-matching-synthetic
HF_TOKEN=

# Retrieval models (downloaded from Hugging Face on first use)
INSTALL_ML=true
ENABLE_DENSE=true
ENABLE_RERANK=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM provider: none | openai | anthropic | ollama
LLM_PROVIDER=none
LLM_MODEL=
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Prices per million tokens, used only to report cost per resume
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10
COVERAGE_THRESHOLD=0.5
